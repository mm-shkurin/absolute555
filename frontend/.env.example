# Порт дев-сервера Vite.
FRONTEND_PORT=5173

# Куда дев-сервер проксирует /api. Свой у каждой копии репозитория, дефолта нет.
# Порт бэкенда: grep BACKEND_PORT ../infra/.env
VITE_API_PROXY_TARGET=http://localhost:8000

# База для запросов в собранном приложении. Пусто — значит тот же origin.
VITE_API_BASE_URL=
