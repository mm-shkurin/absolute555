# infra/.env.example — copy to infra/.env and fill in real values.
# infra/.env is gitignored; never commit it.
#
# This one file feeds both docker-compose.yml (${...} interpolation) and the
# backend container (env_file). Variable names match app/core/config.py aliases.

# --- Host port map (container-side ports are fixed and never read from here) ---
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
CHROMA_HOST_PORT=8001
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=3000

# --- App ---
APP_NAME=absolute
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=false
APP_LOG_LEVEL=info
DOMAIN=localhost
ADMIN_EMAIL=admin@example.com

# --- Postgres ---
# POSTGRES_HOST / *_NETWORK_NAME are compose service names, not host addresses.
POSTGRES_USER=absolute
POSTGRES_PASSWORD=change-me
POSTGRES_DB=absolute
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_NETWORK_NAME=postgres

# --- Redis ---
REDIS_NETWORK_NAME=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USER=
REDIS_USER_PASSWORD=
REDIS_TTL=300

# --- Chroma ---
CHROMA_NETWORK_NAME=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=absolute

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
MINIO_DEFAULT_BUCKETS=absolute
MINIO_NETWORK_NAME=minio
MINIO_PORT=9000
MINIO_ENDPOINT_URL=http://minio:9000
MINIO_BUCKET_NAME=absolute

# --- JWT ---
# SECRET_KEY and REFRESH_TOKEN_SECRET_KEY must be at least 32 characters —
# config.py rejects anything shorter at boot. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
REFRESH_TOKEN_SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=43200

# --- Docs ---
DOCS_API_KEY=change-me

# --- CORS / frontend / cookies ---
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
COOKIE_DOMAIN=localhost
COOKIE_PATH=/
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# --- Yandex ID ---
# Both secrets are validated with min_length=32; a placeholder shorter than that
# fails at boot naming the field.
YANDEX_CLIENTID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:8000/auth/yandex/callback
YANDEX_REDIRECT_URI_WEB=http://localhost:3000/auth/callback

# --- VK ID ---
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_REDIRECT_URI=http://localhost:8000/auth/vk/callback
VK_OAUTH_URL=https://id.vk.com/oauth2/auth
VK_API_URL=https://api.vk.com/method/users.get
VK_AUTH_URL=https://id.vk.com/auth

# --- GigaChat ---
GIGA_AUTH_KEY=
GIGA_CLIENT_ID=
GIGA_SCOPE=GIGACHAT_API_PERS
GIGA_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGA_API_URL=https://gigachat.devices.sberbank.ru/api/v1

# --- Webhooks ---
WEBHOOK_SECRET=change-me
# TG_WEBHOOK_URL is Optional[HttpUrl]: leave it UNSET, never empty. `VAR=` puts an
# empty string in the environment, which pydantic parses as a URL and rejects at
# import time — the backend crash-loops before serving anything.
#TG_WEBHOOK_URL=https://example.com/tg/webhook

# --- Frontend build args (baked into the bundle at build time) ---
# Empty means same-origin: the browser calls /api on the frontend's own host and
# nginx proxies it to the backend container.
REACT_APP_API_URL=
REACT_APP_API_BASE_URL=
